# ==============================================================================
# SARAL - Smart Auto-Responder for Act Laws
# Production Environment Variables Template
# ==============================================================================

# Database Connection (PostgreSQL - Supabase / Neon / Railway / AWS RDS)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
# DIRECT_URL is optional, recommended for Supabase connection poolers (Port 5432)
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# JSON Web Token Secret for Cookie Sessions (Generate with: openssl rand -base64 32)
JWT_SECRET="generate-a-secure-32-character-random-secret-key-here"

# Google Gemini AI Configuration (Citizen Drafting & Officer Adjudication Copilot)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Firebase Client Authentication Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="saral-rti.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="saral-rti"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="saral-rti.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional Civic Directory User Agent
WIKIPEDIA_USER_AGENT="SARAL-Civic-Copilot/1.0 (contact: admin@saral.gov.in)"

# Node Environment
NODE_ENV="production"
